# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# foundry
contracts/lib
contracts/out
contracts/cache
contracts/broadcast

# next generated agent files
/AGENTS.md
/CLAUDE.md

# zk intermediates
artifacts/*.ptau
artifacts/circuit
artifacts/pot*
.bin

# typescript
*.tsbuildinfo
next-env.d.ts
